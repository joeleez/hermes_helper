# ─────────────────────────────────────────────────────
# 複製成 .env 後填入。.env 永不進 git（有 hook 攔截）
# ─────────────────────────────────────────────────────

# ── Agent 身分 ──────────────────────────────────────
AGENT_NAME=pm
# 模型：provider:model 格式。改成你實際用的
HERMES_MODEL=deepseek:deepseek-chat

# ── 模型金鑰（只填你用的那個）──────────────────────
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# ── Feishu（1 個 App）──────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 非常重要：feishu = 中國版（open.feishu.cn）；lark = 國際版（open.larksuite.com）
# 填錯會出現 "connect failed: Incorrect domain name"
FEISHU_DOMAIN=lark
FEISHU_CONNECTION_MODE=websocket
FEISHU_GROUP_POLICY=open
FEISHU_REQUIRE_MENTION=true
# none = 不理其他 bot；mentions = 被 @ 才回應其他 bot
FEISHU_ALLOW_BOTS=none
